# Copie para /srv/oghma/.env.daily-crawl no servidor local.
# Nao commite o arquivo real com tokens.

# Token compartilhado entre ESP32 e oghma-control-server.py.
OGHMA_CONTROL_TOKEN=troque-este-token

# Opcional para testes: limita quantas novels/capitulos o daily processa.
# OGHMA_CRAWL_LIMIT=1
# OGHMA_CHAPTER_LIMIT=3

# Fontes consideradas "finalizadas" e seguras para cron diario.
OGHMA_DAILY_SOURCES="central-novel novel-mania house-saikai sky-demon-order golden-novel mahou-reader rolia-scan"
OGHMA_DAILY_COMMAND_ATTEMPTS=2
OGHMA_DAILY_CRAWL_PARALLELISM=4
OGHMA_BOOT_WAIT_SECONDS=900

# Publica no B2 depois que os crawlers terminarem.
OGHMA_PUBLISH_AFTER_CRAWL=1
# Para teste sem upload real:
# OGHMA_PUBLISH_NO_UPLOAD=1
# OGHMA_PUBLISH_DRY_RUN=1

# Discord DM. Rotacione o token antes de usar em producao se ele ja foi exposto.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
