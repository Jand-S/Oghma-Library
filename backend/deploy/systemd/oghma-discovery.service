[Unit]
Description=Oghma: fichas da historia das obras novas e parecidos pre-calculados
After=postgresql.service

[Service]
Type=oneshot
User=oghma
WorkingDirectory=/opt/oghma/app/backend
EnvironmentFile=/opt/oghma/.env
# Fichas das obras sem ficha (ou com sinopse nova), pelo Codex do usuario dos agentes; para
# sozinho perto do limite do plano e continua na noite seguinte.
ExecStart=/opt/oghma/venv/bin/oghma discovery-fichas
# Parecidos de todo o catalogo (embeddings locais) e publicacao no B2.
ExecStart=/opt/oghma/venv/bin/oghma discovery-build
Nice=15
# O modelo de embeddings (mpnet int8) fica perto de 1 GB.
MemoryMax=1400M
TimeoutStartSec=8h
