# Copie para .env e ajuste. Prefixo OGHMA_.
OGHMA_DATABASE_URL=postgresql+asyncpg://oghma:oghma@db:5432/oghma
OGHMA_STORAGE_ROOT=/srv/oghma
OGHMA_USER_AGENT=OghmaLibraryBot/0.1 (+preservacao/biblioteca pessoal)
OGHMA_DEFAULT_RATE_LIMIT_SECONDS=2.0
OGHMA_REQUEST_TIMEOUT_SECONDS=30.0
OGHMA_FTS_LANGUAGE=portuguese
# Opcional. House Saikai tem catalogo/capitulos publicos no momento, mas este
# Bearer pode ser usado caso alguma rota passe a exigir sessao. Nao commitar valor real.
OGHMA_HOUSE_SAIKAI_BEARER=
# Porta publicada no host. No servidor atual, 8000 ja e usado pelo Comfy-Ultimate.
OGHMA_API_HOST_PORT=8010
# Postgres (docker-compose):
POSTGRES_USER=oghma
POSTGRES_PASSWORD=oghma
POSTGRES_DB=oghma
# Onde os DADOS ficam no HOST. Aponte para o HDD de 4TB para guardar o acervo la.
# Ex.: OGHMA_STORAGE_HOST=/mnt/hdd/oghma/files  e  OGHMA_PG_HOST=/mnt/hdd/oghma/pg
# Arquivos (capitulos/capas/exports):
OGHMA_STORAGE_HOST=/srv/oghma/files
# Dados do Postgres (deixe comentado p/ usar volume docker no disco do sistema):
OGHMA_PG_HOST=/srv/oghma/pg
